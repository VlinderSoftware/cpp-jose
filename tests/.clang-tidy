---
# clang-tidy configuration for test files
# Inherits from parent but disables checks that are too strict for test code

# Inherit all checks from parent and disable test-specific ones
InheritParentConfig: true

Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -modernize-use-trailing-return-type,
  -readability-else-after-return,
  -readability-identifier-length,
  -readability-function-size,
  -readability-function-cognitive-complexity,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-owning-memory,
  -cert-err58-cpp,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-goto,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic

# Don't treat warnings as errors in test files
WarningsAsErrors: ''

# Test-suite formatting and style notes
# - Pointer/reference style: Prefer `T const &t`, `T &t`, `T *p`, `T const *p`.
#   Use clang-format and code review to maintain this style in tests as well.
# - Template spacing: Prefer a space before the closing angle bracket in templates and
#   template instantiations (e.g. `std::vector< T >`). Enforce via `.clang-format`.

